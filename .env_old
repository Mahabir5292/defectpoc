# =========================
# REQUIRED: AWS and S3 input
# =========================
AWS_REGION=eu-central-1
S3_BUCKET=defectanalysisdemobucket
DEFECTS_S3_KEY=jira-uploads/sample_defects.xlsx
INCIDENTS_S3_KEY=jira-uploads/sample_incidents.xlsx

# =========================
# PostgreSQL metadata store
# =========================
POSTGRES_DB=triage
POSTGRES_USER=triage
POSTGRES_PASSWORD=triage
DATABASE_URL=postgresql+psycopg://triage:triage@postgres:5432/triage

# =========================
# Qdrant vector store
# =========================
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=jira_tickets_titan_v2

# =========================
# Embeddings: keep Titan V2 as before
# EC2 IAM role needs bedrock:InvokeModel
# =========================
EMBEDDING_PROVIDER=bedrock
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024

# =========================
# Optional answer-generating LLM
# none = retrieval-only and quickest startup
# huggingface = local lightweight LLM, no Bedrock chat model required
# bedrock = Bedrock Converse using LLM_MODEL_ID
# =========================
LLM_PROVIDER=none
HF_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
HF_MAX_NEW_TOKENS=350
HF_TEMPERATURE=0.1
HF_DEVICE=cpu
HF_CACHE_DIR=/models/huggingface
LLM_MODEL_ID=

# =========================
# Retrieval and UI
# =========================
TOP_K=12
FINAL_K=5
MIN_SCORE=0.35
MAX_CONTEXT_CHARS=12000
BACKEND_URL=http://backend:8001
LOG_LEVEL=INFO
